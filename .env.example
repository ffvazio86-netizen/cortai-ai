# Local backend port
PORT=3000

# Optional persistent directory for uploaded videos and generated cuts.
# For Render, set this to the mount path of a persistent disk, e.g. /var/data.
# Leave unset for the default temporary directory during local development.
CORTAI_STORAGE_DIR=

# Temporary storage safety: invalid/out-of-range values fall back to safe defaults.
# Storage quota: 100 to 102400 MB (default 500 MB).
# File retention: 1 to 720 hours (default 2 hours).
CORTAI_MAX_STORAGE_MB=500
CORTAI_FILE_TTL_HOURS=2

# Set to 1 only when deployed behind Render's single trusted proxy.
# Leave unset locally. Do not enable behind an unknown/multiple proxy chain.
TRUST_PROXY=0


# Authentication is enabled by default. Generate a random value of at least 32 bytes.
# Example: openssl rand -base64 48
CORTAI_SESSION_SECRET=
AUTH_REQUIRED=1

# Optional path for the SQLite user/session database. Defaults to
# $CORTAI_STORAGE_DIR/cortai-auth.sqlite or the OS temporary directory.
CORTAI_DATABASE_PATH=

# Optional Google Identity Services OAuth 2.0 Web client ID (public identifier).
# Create it in Google Cloud Console and configure the authorized JavaScript origin.
GOOGLE_CLIENT_ID=

# Public origin used to validate auth request origins, e.g. https://cortai.example.com
CORTAI_PUBLIC_ORIGIN=
