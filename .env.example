# Local backend port
PORT=3000

# Optional persistent directory for uploaded videos and generated cuts.
# For Render, set this to the mount path of a persistent disk, e.g. /var/data.
# Leave unset for the default temporary directory during local development.
CORTAI_STORAGE_DIR=

# Optional: set to the public frontend origin when CORS is added
FRONTEND_ORIGIN=http://localhost:3000
