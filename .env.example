# Local backend port
PORT=3000

# Optional persistent directory for uploaded videos and generated cuts.
# For Render, set this to the mount path of a persistent disk, e.g. /var/data.
# Leave unset for the default temporary directory during local development.
CORTAI_STORAGE_DIR=

# Temporary storage safety: invalid/out-of-range values fall back to safe defaults.
# Storage quota: 100 to 102400 MB (default 500 MB).
# File retention: 1 to 720 hours (default 2 hours).
CORTAI_MAX_STORAGE_MB=500
CORTAI_FILE_TTL_HOURS=2

# Set to 1 only when deployed behind Render's single trusted proxy.
# Leave unset locally. Do not enable behind an unknown/multiple proxy chain.
TRUST_PROXY=0

# Optional: set to the public frontend origin when CORS is added
FRONTEND_ORIGIN=http://localhost:3000
